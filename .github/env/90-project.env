# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for paymail-inspector
# Load Order: 90 (loaded after all defaults, overrides tool-specific settings)
#
# This file contains project-specific configuration that overrides defaults from
# earlier env files (00-core, 10-*, 20-*). Only values that differ from defaults
# need to be specified here. It is NOT synced by go-broadcast.
#
# Maintainer: @mrz1836
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Project Go versions (overrides 00-core.env defaults)
GO_PRIMARY_VERSION=1.26.x
GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 🪄 MAGE-X GO VERSION OVERRIDES
# ================================================================================================

MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x

# Dev-build install location: magex build:dev installs here (kept on PATH ahead of
# GOBIN) so a freshly built binary is not shadowed by an older release install.
# Honored by mage-x versions that support it; harmlessly ignored by older ones.
MAGE_X_INSTALL_DIR=~/.local/bin

# ================================================================================================
# 📊 COVERAGE PROVIDER
# ================================================================================================

# Use Codecov for coverage reporting (overrides 10-coverage.env default of 'internal')
GO_COVERAGE_PROVIDER=codecov
CODECOV_TOKEN_REQUIRED=true

# The suite runs fully offline and covers ~98% of statements; hold the line well
# above the fleet default (65%) so untested code cannot slip in unnoticed.
GO_COVERAGE_THRESHOLD=90.0

# Coverage exclusions matching codecov.yml ignore paths
GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,docs/
